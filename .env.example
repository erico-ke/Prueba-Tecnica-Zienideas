# Copia este archivo a .env y rellena los valores de tu App Registration en Entra ID.
# Portal de Azure -> Microsoft Entra ID -> App registrations -> tu app -> Overview

# Directory (tenant) ID
TENANT_ID=00000000-0000-0000-0000-000000000000

# Application (client) ID
CLIENT_ID=00000000-0000-0000-0000-000000000000

# Certificates & secrets -> New client secret -> copia el "Value" (no el "Secret ID")
CLIENT_SECRET=tu-client-secret




